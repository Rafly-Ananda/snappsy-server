# Build
VERSION=v1.0.0
BUILD_TIME=

# App
APP_ENV=development
APP_PORT=8080
ALLOWED_ORIGINS=http://localhost:3000

# Admin
ADMIN_USERNAME=snappsy-admin
ADMIN_PASSWORD=snappsy-dev-password
# Quote bcrypt hashes; dotenv expands unquoted $2a$... values.
ADMIN_PASSWORD_HASH=''
ADMIN_SESSION_TTL_MINUTES=720
CUSTOMER_SESSION_TTL_MINUTES=720

# Public hostnames used by the nginx template.
API_DOMAIN=api.localhost
FILES_DOMAIN=files.localhost
CONSOLE_DOMAIN=console.localhost

# Host-local development defaults for `make dev` (Air runs on your machine).
# Dockerized `make dev-full` overrides these with compose service names.
SEAWEEDFS_ENDPOINT=localhost:9000
SEAWEEDFS_PUBLIC_URL=http://localhost:9000
SEAWEEDFS_USE_SSL=false
SEAWEEDFS_ACCESS_KEY=snappsy-access-key
SEAWEEDFS_SECRET_KEY=snappsy-secret-key
SEAWEEDFS_BUCKET=images
SEAWEEDFS_PRESIGNED_EXPIRY_MINUTES=30
SEAWEEDFS_ADMIN_PASSWORD=snappsy-dev-admin

# Boomerang worker
WORKER_MODE=false
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
BOOMERANG_WORKER_CONCURRENCY=1
BOOMERANG_MAX_SOURCE_BYTES=52428800
BOOMERANG_MAX_SOURCE_SECONDS=30
BOOMERANG_SEGMENT_SECONDS=3
BOOMERANG_QUEUE_LIMIT=100

# Public demo booth. Admin can override these in the dashboard.
DEMO_ENABLED=true
DEMO_PHOTO_ENABLED=true
DEMO_STRIP_ENABLED=true
DEMO_BOOMERANG_ENABLED=true
DEMO_COUNTDOWN_SECONDS=3

# Google Drive export (Phase 5)
# Frontend base URL used in OAuth callback and customer setup links.
PUBLIC_APP_URL=http://localhost:3000

# OAuth 2.0 Web application client from Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI on the OAuth client.
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/drive/oauth/callback

# Google Picker browser API key. Restrict it to the frontend origins:
# http://localhost:3000/* and the production frontend origin.
GOOGLE_PICKER_API_KEY=
# Google Cloud project number used by Picker as the app ID.
GOOGLE_PICKER_APP_ID=

# Exactly 32 random bytes, base64 encoded:
# openssl rand -base64 32
DRIVE_TOKEN_ENCRYPTION_KEY=

DRIVE_SETUP_TOKEN_TTL_MINUTES=30
DRIVE_EXPORT_CONCURRENCY=1
DRIVE_QUEUE_LIMIT=1000

# MongoDB
MONGODB_HOST=localhost:27017
MONGODB_USERNAME=snappsy
MONGODB_PASSWORD=snappsy-dev-password
MONGO_INITDB_DATABASE=snappsy
MONGO_OPTIONS="authSource=admin"

# MongoDB Collections
MONGO_MEDIA_ITEMS_COLLECTION="media_items"
MONGO_IMAGES_COLLECTION="images"
MONGO_EVENTS_COLLECTION="events"
MONGO_USER_COLLECTION="users"
MONGO_ASSETS_COLLECTION="assets"
MONGO_TEMPLATES_COLLECTION="templates"
MONGO_TEMPLATE_VERSIONS_COLLECTION="template_versions"
MONGO_UPLOAD_INTENTS_COLLECTION="upload_intents"
MONGO_MEDIA_JOBS_COLLECTION="media_jobs"
MONGO_DRIVE_COLLECTION="drive"
MONGO_CUSTOMERS_COLLECTION="customers"
MONGO_CUSTOMER_SESSIONS_COLLECTION="customer_sessions"
MONGO_EVENT_PLANS_COLLECTION="event_plans"
MONGO_PLATFORM_SETTINGS_COLLECTION="platform_settings"
